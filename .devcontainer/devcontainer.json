{
    "name": "ROS2 Jazzy",

    "dockerComposeFile": "../docker/compose.yaml",

    "service": "ros2",

    "workspaceFolder": "/ros_ws",

    "remoteUser": "root",

    "remoteEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "XAUTHORITY": "/tmp/.mutter-Xwaylandauth"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-iot.vscode-ros"
            ]
        }
    }
}
